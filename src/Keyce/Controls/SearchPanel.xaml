<UserControl x:Class="Keyce.Controls.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Sidebar.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="RECHERCHER" Margin="20,0" VerticalAlignment="Center" FontSize="11"
                   Foreground="{DynamicResource Sidebar.HeaderForeground}"/>
        <StackPanel Grid.Row="1" Margin="12,8">
            <TextBox x:Name="QueryBox" MinHeight="28" Padding="6,4" FontSize="12"
                     Background="{DynamicResource Window.Background}" Foreground="{DynamicResource Text.Default}"
                     BorderBrush="{DynamicResource Border.Default}" ToolTip="Rechercher dans les fichiers du dossier ouvert"
                     KeyDown="QueryBox_KeyDown"/>
            <DockPanel Margin="0,8,0,0">
                <Button Content="Rechercher" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Padding="10,4" Click="Search_Click"/>
                <CheckBox x:Name="MatchCaseBox" Content="Respecter la casse" VerticalAlignment="Center"
                          Foreground="{DynamicResource Text.Muted}" FontSize="11"/>
            </DockPanel>
        </StackPanel>
        <ListBox x:Name="ResultsList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="3,5">
                        <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource Text.Default}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Text.Muted}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Text.Muted}"
                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="SearchStatus" Grid.Row="3" Margin="12,8" VerticalAlignment="Center"
                   Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                   Text="Ouvre un dossier pour rechercher dans son contenu." IsHitTestVisible="False"/>
    </Grid>
</UserControl>
