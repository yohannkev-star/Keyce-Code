<UserControl x:Class="Keyce.Controls.EditorTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Keyce.Controls"
             xmlns:local="clr-namespace:Keyce"
             PreviewKeyDown="EditorTabs_PreviewKeyDown">
    <Grid Background="{DynamicResource Editor.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="WelcomeTab" Grid.Row="0" Height="36" Background="{DynamicResource Tab.ActiveBackground}"
                BorderBrush="{DynamicResource Tab.ActiveBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Fonts.Icon}" Foreground="{DynamicResource Accent}"
                           FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Bienvenue" FontStyle="Italic" Foreground="{DynamicResource Tab.ActiveForeground}"/>
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDocuments, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <ListBox x:Name="TabsList" Grid.Row="0" ItemsSource="{Binding Documents, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 SelectedItem="{Binding SelectedDocument, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                 Background="{DynamicResource Tab.Background}" BorderThickness="0,0,0,1"
                 BorderBrush="{DynamicResource Border.Default}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="TabsList_SelectionChanged">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDocuments, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource Tab.Foreground}"/>
                    <Setter Property="Background" Value="{DynamicResource Tab.Background}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Tab.ActiveForeground}"/>
                            <Setter Property="Background" Value="{DynamicResource Tab.ActiveBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Tab.ActiveBorder}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel MinHeight="34" MaxWidth="240" Margin="10,0,5,0" VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Content="×" Width="20" Height="20" Margin="8,0,0,0"
                                Padding="0" BorderThickness="0" Background="Transparent"
                                Foreground="{DynamicResource Text.Muted}" ToolTip="Fermer l'onglet"
                                Click="CloseTab_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text=" ●" Foreground="{DynamicResource Accent}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" x:Name="WelcomeScreen" Margin="0" Background="{DynamicResource Editor.Background}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="1000" Margin="36,30" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="Bienvenue" FontSize="26" FontWeight="Light" Margin="0,0,0,20"
                                   Foreground="{DynamicResource Text.Default}"/>
                        <TextBlock Text="DÉMARRER" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource Text.Muted}"/>
                        <Button Content="Nouveau fichier" Style="{StaticResource LinkButton}" Command="New"
                                HorizontalContentAlignment="Left" Margin="0,5"/>
                        <Button Content="Ouvrir un fichier…" Style="{StaticResource LinkButton}" Command="Open"
                                HorizontalContentAlignment="Left" Margin="0,5"/>
                        <Button Content="Ouvrir un dossier…" Style="{StaticResource LinkButton}"
                                Command="{x:Static local:AppCommands.OpenFolder}" HorizontalContentAlignment="Left" Margin="0,5"/>
                        <Button Content="Nouveau projet Console C#…" Style="{StaticResource LinkButton}"
                                Command="{x:Static local:AppCommands.NewProject}" HorizontalContentAlignment="Left" Margin="0,5"/>

                        <TextBlock Text="RÉCENTS" FontSize="12" FontWeight="SemiBold" Margin="0,30,0,12"
                                   Foreground="{DynamicResource Text.Muted}"/>
                        <ItemsControl ItemsSource="{Binding RecentWorkspaces, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" HorizontalContentAlignment="Left"
                                            Click="RecentWorkspace_Click" Tag="{Binding}" Margin="0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource Text.Muted}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucun dossier récent" FontSize="12" Foreground="{DynamicResource Text.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentWorkspaces.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="DÉCOUVRIR KEYCE CODE" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Foreground="{DynamicResource Text.Muted}"/>
                        <Border Background="{DynamicResource Sidebar.Background}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⌨  Vos premiers pas" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Default}"/>
                                <TextBlock Text="Créez un fichier, ouvrez un dossier et explorez votre code dans l’Explorateur."
                                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Text.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Sidebar.Background}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ToolchainWelcome, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Default}"/>
                                <TextBlock Text="Lancez votre programme avec F5 et consultez les résultats dans le panneau Sortie."
                                           TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Text.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Sidebar.Background}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="4" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Raccourcis utiles" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Default}"/>
                                <TextBlock Margin="0,8,0,0" LineHeight="22" Foreground="{DynamicResource Text.Muted}">
                                    Ctrl+N  Nouveau fichier<LineBreak/>
                                    Ctrl+O  Ouvrir un fichier<LineBreak/>
                                    Ctrl+S  Enregistrer<LineBreak/>
                                    Ctrl+B  Explorateur<LineBreak/>
                                    F5  Exécuter
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDocuments, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>

        <controls:CodeEditor x:Name="Editor" Grid.Row="1" TextChanged="Editor_TextChanged">
            <controls:CodeEditor.Style>
                <Style TargetType="controls:CodeEditor">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDocuments, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:CodeEditor.Style>
        </controls:CodeEditor>
    </Grid>
</UserControl>
