<SyntaxDefinition name="Python" extensions=".py" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" foreground="%KEYWORD%" />
  <Color name="Control" foreground="%CONTROL%" />
  <Color name="Type" foreground="%TYPE%" />
  <Color name="Method" foreground="%METHOD%" />
  <Color name="String" foreground="%STRING%" />
  <Color name="Comment" foreground="%COMMENT%" />
  <Color name="Number" foreground="%NUMBER%" />
  <RuleSet>
    <Span color="Comment" begin="\#" />
    <Span color="String" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;" multiline="true" />
    <Span color="String" begin="'''" end="'''" multiline="true" />
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>
    <Span color="String" begin="'" end="'">
      <RuleSet><Span begin="\\" end="." /></RuleSet>
    </Span>
    <Keywords color="Control">
      <Word>if</Word><Word>elif</Word><Word>else</Word><Word>for</Word><Word>while</Word>
      <Word>break</Word><Word>continue</Word><Word>return</Word><Word>yield</Word>
      <Word>try</Word><Word>except</Word><Word>finally</Word><Word>raise</Word>
      <Word>with</Word><Word>match</Word><Word>case</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>and</Word><Word>as</Word><Word>assert</Word><Word>async</Word><Word>await</Word>
      <Word>class</Word><Word>def</Word><Word>del</Word><Word>from</Word><Word>global</Word>
      <Word>import</Word><Word>in</Word><Word>is</Word><Word>lambda</Word><Word>nonlocal</Word>
      <Word>not</Word><Word>or</Word><Word>pass</Word><Word>True</Word><Word>False</Word>
      <Word>None</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>bool</Word><Word>bytearray</Word><Word>bytes</Word><Word>complex</Word>
      <Word>dict</Word><Word>float</Word><Word>frozenset</Word><Word>int</Word>
      <Word>list</Word><Word>object</Word><Word>range</Word><Word>set</Word>
      <Word>str</Word><Word>tuple</Word><Word>type</Word>
    </Keywords>
    <Rule color="Number">\b(0[xX][0-9A-Fa-f]+|0[bB][01]+|\d+(\.\d+)?([eE][+-]?\d+)?)[jJ]?\b</Rule>
    <Rule color="Method">\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()</Rule>
  </RuleSet>
</SyntaxDefinition>
